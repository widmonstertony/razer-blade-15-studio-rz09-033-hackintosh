+VoodooI2CNativeEngine::RazerContactDecision
+VoodooI2CNativeEngine::updateRazerContactState(
+    UInt32 slot,
+    VoodooI2CDigitiserTransducer* transducer,
+    bool typingActive,
+    UInt64 nowNs) {
+    RazerContactDecision decision;
+    if (!razerPrecisionTouchpad || !palmRejectionEnabled ||
+        !palmRejectionTypingLockout || slot >= VOODOO_INPUT_MAX_TRANSDUCERS)
+        return decision;
+
+    RazerContactState& state = razerContacts[slot];
+
+    // The typing signal is authoritative even when this particular slot is
+    // absent or marked invalid in the current HID frame. If macOS has already
+    // seen the contact, emit exactly one Stop and quarantine the generation.
+    if (typingActive && state.phase == kRazerContactAllowed) {
+        if (state.published) {
+            decision.emitStop = true;
+            decision.stopAsPalm = true;
+            decision.stopSecondaryId = state.secondaryId;
+            decision.stopX = state.lastX;
+            decision.stopY = state.lastY;
+        }
+        state.phase = kRazerContactLocked;
+        state.published = false;
+        allowedToLockedCount++;
+        suppressedContactCount++;
+    } else if (typingActive && state.phase == kRazerContactPending) {
+        state.phase = kRazerContactLocked;
+        pendingCapturedCount++;
+        suppressedContactCount++;
+    }
+
+    // Missing and DataValid=0 are not release events. In particular, never
+    // clear Locked here: the same slot must report a real TipSwitch 1 -> 0.
+    if (!transducer || !transducer->is_valid) {
+        decision.rejected = state.phase == kRazerContactPending ||
+                            state.phase == kRazerContactLocked;
+        return decision;
+    }
+
+    const bool tipDown = transducer->tip_switch.current.value != 0;
+
+    if (state.phase != kRazerContactEmpty && state.rawTipDown && !tipDown) {
+        if (!decision.emitStop && state.published) {
+            decision.emitStop = true;
+            decision.stopSecondaryId = state.secondaryId;
+            decision.stopX = state.lastX;
+            decision.stopY = state.lastY;
+        }
+        state.phase = kRazerContactEmpty;
+        state.rawTipDown = false;
+        state.published = false;
+        state.needsCleanStart = false;
+        state.pendingSinceNs = 0;
+        return decision;
+    }
+
+    if (!tipDown) {
+        // An idle slot remains Empty. A logically active state with no prior
+        // observed Down can only arise after lifecycle reset/corruption, so
+        // fail closed instead of manufacturing a new generation.
+        state.rawTipDown = false;
+        decision.rejected = state.phase == kRazerContactPending ||
+                            state.phase == kRazerContactLocked;
+        return decision;
+    }
+
+    // A new ContactIdentifier while the same descriptor slot remains TipDown
+    // is a physical generation boundary. Close the old published ID first;
+    // never overwrite it and accidentally continue an Allowed generation.
+    if (state.phase != kRazerContactEmpty && state.rawTipDown &&
+        transducer->secondary_id != state.secondaryId) {
+        if (!decision.emitStop && state.published) {
+            decision.emitStop = true;
+            decision.stopSecondaryId = state.secondaryId;
+            decision.stopX = state.lastX;
+            decision.stopY = state.lastY;
+        }
+        state.phase = kRazerContactEmpty;
+        state.rawTipDown = false;
+        state.published = false;
+        state.needsCleanStart = false;
+        state.pendingSinceNs = 0;
+    }
+
+    if (state.phase == kRazerContactEmpty) {
+        state.generation++;
+        state.rawTipDown = true;
+        state.published = false;
+        state.needsCleanStart = true;
+        state.secondaryId = transducer->secondary_id;
+        state.lastX = transducer->coordinates.x.current.value;
+        state.lastY = transducer->coordinates.y.current.value;
+        state.pendingSinceNs = nowNs;
+        if (typingActive) {
+            state.phase = kRazerContactLocked;
+            suppressedContactCount++;
+        } else {
+            state.phase = kRazerContactPending;
+            pendingAdmissionCount++;
+        }
+        decision.rejected = true;
+        return decision;
+    }
+
+    state.rawTipDown = true;
+    state.lastX = transducer->coordinates.x.current.value;
+    state.lastY = transducer->coordinates.y.current.value;
+
+    if (state.phase == kRazerContactPending) {
+        const UInt64 elapsedNs = nowNs >= state.pendingSinceNs
+            ? nowNs - state.pendingSinceNs
+            : 0;
+        if (elapsedNs >= kRazerPendingAdmissionNs) {
+            state.phase = kRazerContactAllowed;
+            state.pendingSinceNs = 0;
+            return decision;
+        }
+        decision.rejected = true;
+        return decision;
+    }
+
+    decision.rejected = state.phase == kRazerContactLocked;
+    return decision;
+}
