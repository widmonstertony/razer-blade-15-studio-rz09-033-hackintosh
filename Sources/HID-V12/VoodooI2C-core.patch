+IOService* VoodooI2CNativeEngine::retainVoodooInputClient() {
+    IOService* client = nullptr;
+    if (!clientLock)
+        return nullptr;
+
+    IOLockLock(clientLock);
+    if (voodooInputInstance) {
+        client = voodooInputInstance;
+        client->retain();
+    }
+    IOLockUnlock(clientLock);
+    return client;
+}
