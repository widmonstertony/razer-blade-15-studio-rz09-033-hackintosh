+bool VoodooI2CNativeEngine::isPalmZone(UInt32 x, UInt32 y, UInt32 maxX, UInt32 maxY) const {
+    if (maxX == 0 || maxY == 0)
+        return false;
+
+    const UInt64 scaledX = static_cast<UInt64>(x) * 100U;
+    const UInt64 scaledY = static_cast<UInt64>(y) * 100U;
+    const UInt64 width = maxX;
+    const UInt64 height = maxY;
+
+    const bool inTopCorner =
+        scaledY <= height * palmTopZonePercent &&
+        (scaledX <= width * palmTopCornerZonePercent ||
+         scaledX >= width * (100U - palmTopCornerZonePercent));
+    const bool inFullHeightSideRail =
+        scaledX <= width * palmSideZonePercent ||
+        scaledX >= width * (100U - palmSideZonePercent);
+    const bool inLowerShoulder =
+        scaledY >= height * palmShoulderStartPercent &&
+        (scaledX <= width * palmShoulderZonePercent ||
+         scaledX >= width * (100U - palmShoulderZonePercent));
+
+    return inTopCorner || inFullHeightSideRail || inLowerShoulder;
+}
