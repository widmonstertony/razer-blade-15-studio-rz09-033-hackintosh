+VoodooI2CNativeEngine::PalmContactState*
+VoodooI2CNativeEngine::findPalmState(UInt16 secondaryId, bool create) {
+    PalmContactState* freeState = nullptr;
+
+    for (UInt32 i = 0; i < VOODOO_INPUT_MAX_TRANSDUCERS; i++) {
+        if (palmContacts[i].active && palmContacts[i].secondaryId == secondaryId)
+            return &palmContacts[i];
+        if (!palmContacts[i].active && !freeState)
+            freeState = &palmContacts[i];
+    }
+
+    if (!create || !freeState)
+        return nullptr;
+
+    freeState->active = true;
+    freeState->seen = false;
+    freeState->initialized = false;
+    freeState->rejected = false;
+    freeState->typingLockout = false;
+    freeState->hardwarePalm = false;
+    freeState->secondaryId = secondaryId;
+    freeState->originX = 0;
+    freeState->originY = 0;
+    return freeState;
+}
+
+bool VoodooI2CNativeEngine::updatePalmState(
+    VoodooI2CDigitiserTransducer* transducer,
+    bool typingActive) {
+    if (!palmRejectionEnabled || displayIntegrated || !transducer)
+        return false;
 
-    if (!firstTransducer)
+    if (!transducer->is_valid) {
+        PalmContactState* invalidState = findPalmState(transducer->secondary_id, false);
+        if (invalidState) {
+            invalidState->active = false;
+            invalidState->initialized = false;
+            invalidState->rejected = false;
+            invalidState->typingLockout = false;
+            invalidState->hardwarePalm = false;
+        }
+        return false;
+    }
+
+    const bool touching = transducer->tip_switch.current.value != 0;
+    PalmContactState* state = findPalmState(transducer->secondary_id, touching);
+    if (!state)
+        return false;
+
+    state->seen = true;
+
+    if (!touching) {
+        state->active = false;
+        state->initialized = false;
+        state->rejected = false;
+        state->typingLockout = false;
+        state->hardwarePalm = false;
+        return false;
+    }
+
+    if (!state->initialized) {
+        state->initialized = true;
+        state->originX = transducer->coordinates.x.current.value;
+        state->originY = transducer->coordinates.y.current.value;
+    }
+
+    const bool wasRejected = state->rejected;
+
+    // This Synaptics CD73 exposes neither Digitizer Confidence nor contact
+    // Width/Height. A geometry-only classifier therefore cannot reliably tell
+    // an inward palm heel from a finger. Use the real keyboard pulse as the
+    // authoritative admission boundary: while typing, suppress every touch
+    // contact. New contacts outside that short window remain native, while a
+    // contact already captured by typing stays quarantined until real tip-up.
+    // Apply the same press-cycle rule to the mechanical click switch.
+    if (typingActive && palmRejectionTypingLockout) {
+        state->rejected = true;
+        state->typingLockout = true;
+    }
+
+    // Retain the generic fallback for other hardware or a configuration that
+    // explicitly disables deterministic typing lockout.
+    if (!state->rejected && typingActive &&
+        !transducer->confidence.value()) {
+        state->hardwarePalm = true;
+        state->rejected = true;
+    }
+
+    // The generic geometry fallback remains latched until tip-up. Checking the
+    // stored origin prevents an intentional central finger from being rejected
+    // merely for moving toward an edge. A contact captured by the deterministic
+    // typing lockout stays rejected until the device reports a real tip-up;
+    // ending the keyboard deadline must not synthesize a fresh contact under a
+    // resting palm.
+    if (!state->rejected && typingActive && palmRejectionFallback &&
+        transducer->logical_max_x > 0 && transducer->logical_max_y > 0 &&
+        isPalmZone(state->originX, state->originY,
+                   static_cast<UInt32>(transducer->logical_max_x),
+                   static_cast<UInt32>(transducer->logical_max_y))) {
+        state->rejected = true;
+    }
+
+    if (!wasRejected && state->rejected)
+        suppressedContactCount++;
+
+    return state->rejected;
+}
+
+void VoodooI2CNativeEngine::beginPalmFrame() {
+    for (UInt32 i = 0; i < VOODOO_INPUT_MAX_TRANSDUCERS; i++)
+        palmContacts[i].seen = false;
+}
+
+void VoodooI2CNativeEngine::endPalmFrame() {
+    for (UInt32 i = 0; i < VOODOO_INPUT_MAX_TRANSDUCERS; i++) {
+        if (palmContacts[i].active && !palmContacts[i].seen) {
+            palmContacts[i].active = false;
+            palmContacts[i].initialized = false;
+            palmContacts[i].rejected = false;
+            palmContacts[i].typingLockout = false;
+            palmContacts[i].hardwarePalm = false;
+            palmContacts[i].originX = 0;
+            palmContacts[i].originY = 0;
+        }
+    }
+}
+
+void VoodooI2CNativeEngine::publishPalmDiagnosticsIfNeeded() {
+    const bool publishTyping =
+        typingActiveFrameCount != publishedTypingActiveFrameCount &&
+        (publishedTypingActiveFrameCount == 0 ||
+         typingActiveFrameCount - publishedTypingActiveFrameCount >= 64);
+    const bool publishSuppressed =
+        suppressedContactCount != publishedSuppressedContactCount &&
+        (publishedSuppressedContactCount == 0 ||
+         suppressedContactCount - publishedSuppressedContactCount >= 64);
+    const bool publishSuppressedButton =
+        suppressedButtonCount != publishedSuppressedButtonCount &&
+        (publishedSuppressedButtonCount == 0 ||
+         suppressedButtonCount - publishedSuppressedButtonCount >= 64);
+    const bool publishPendingAdmission =
+        pendingAdmissionCount != publishedPendingAdmissionCount &&
+        (publishedPendingAdmissionCount == 0 ||
+         pendingAdmissionCount - publishedPendingAdmissionCount >= 64);
+    const bool publishPendingCaptured =
+        pendingCapturedCount != publishedPendingCapturedCount &&
+        (publishedPendingCapturedCount == 0 ||
+         pendingCapturedCount - publishedPendingCapturedCount >= 64);
+    const bool publishAllowedToLocked =
+        allowedToLockedCount != publishedAllowedToLockedCount &&
+        (publishedAllowedToLockedCount == 0 ||
+         allowedToLockedCount - publishedAllowedToLockedCount >= 64);
+
+    if (publishTyping) {
+        setProperty("PalmRejectionTypingActiveFrameCount",
+                    typingActiveFrameCount, 64);
+        publishedTypingActiveFrameCount = typingActiveFrameCount;
+    }
+    if (publishSuppressed) {
+        setProperty("PalmRejectionSuppressedContactCount",
+                    suppressedContactCount, 64);
+        publishedSuppressedContactCount = suppressedContactCount;
+    }
+    if (publishSuppressedButton) {
+        setProperty("PalmRejectionSuppressedButtonCount",
+                    suppressedButtonCount, 64);
+        publishedSuppressedButtonCount = suppressedButtonCount;
+    }
+    if (publishPendingAdmission) {
+        setProperty("PalmRejectionPendingAdmissionCount",
+                    pendingAdmissionCount, 64);
+        publishedPendingAdmissionCount = pendingAdmissionCount;
+    }
+    if (publishPendingCaptured) {
+        setProperty("PalmRejectionPendingCapturedCount",
+                    pendingCapturedCount, 64);
+        publishedPendingCapturedCount = pendingCapturedCount;
+    }
+    if (publishAllowedToLocked) {
+        setProperty("PalmRejectionAllowedToLockedCount",
+                    allowedToLockedCount, 64);
+        publishedAllowedToLockedCount = allowedToLockedCount;
+    }
+}
