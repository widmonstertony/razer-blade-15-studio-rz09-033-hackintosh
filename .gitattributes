# Preserve binaries byte-for-byte and force auditable text files to LF.
* -text
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.plist text eol=lf
*.dsl text eol=lf
*.hex text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.sh text eol=lf
*.patch text eol=lf whitespace=-trailing-space,-space-before-tab
**/CodeResources text eol=lf
.contentFlavour text eol=lf
.contentVisibility text eol=lf
LICENSE text eol=lf
